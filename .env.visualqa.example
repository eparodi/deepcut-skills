# Visual QA key file — copy this to .env.visualqa (gitignored) and fill in
# your key. .env.visualqa is never committed; the environment variable
# DEEPSEEK_API_KEY takes precedence over this file, and --model beats both.
DEEPSEEK_API_KEY=
# Optional: vision model override (default deepseek-v4-flash-vision-exp)
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Optional: auth cookie to inject before navigation (US9) — flag > env > this file
# VISUALQA_COOKIE=session=<signed-token>

{
  "feature": "htmx-dashboard-desktop",
  "base_url": "http://localhost:8080",
  "cases": [
    {
      "name": "nav swap keeps content visible",
      "steps": [
        { "action": "goto", "url": "/" },
        { "action": "wait", "ms": 1000 },
        { "action": "screenshot", "name": "home-before", "html": true },
        { "action": "click", "selector": "aside.sidebar a[href=\"/stats\"]", "capture": true },
        { "action": "wait", "ms": 1200 },
        { "action": "screenshot", "name": "stats-after-click", "html": true }
      ]
    },
    {
      "name": "pages tour",
      "steps": [
        { "action": "goto", "url": "/" },
        { "action": "wait", "ms": 800 },
        { "action": "click", "selector": "aside.sidebar a[href=\"/analytics\"]", "capture": true },
        { "action": "wait", "ms": 900 },
        { "action": "click", "selector": "aside.sidebar a[href=\"/ledger\"]", "capture": true },
        { "action": "wait", "ms": 900 },
        { "action": "click", "selector": "aside.sidebar a[href=\"/settings\"]", "capture": true },
        { "action": "wait", "ms": 900 },
        { "action": "screenshot", "name": "settings-after-nav-tour", "html": true }
      ]
    },
    {
      "name": "subnav buttons survive the swap",
      "steps": [
        { "action": "goto", "url": "/" },
        { "action": "wait", "ms": 1000 },
        { "action": "click", "selector": "nav.subnav a[href=\"/analytics\"]" },
        { "action": "wait", "ms": 1200 },
        { "action": "screenshot", "name": "subnav-after-click", "html": true }
      ]
    },
    {
      "name": "section layout",
      "steps": [
        { "action": "goto", "url": "/section" },
        { "action": "wait", "ms": 1200 },

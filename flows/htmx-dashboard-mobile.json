{
  "feature": "htmx-dashboard-mobile",
  "base_url": "http://localhost:8080",
  "cases": [
    {
      "name": "nav swap keeps content visible",
      "steps": [
        { "action": "goto", "url": "/" },
        { "action": "wait", "ms": 1000 },
        { "action": "screenshot", "name": "home-before", "html": true },
        { "action": "click", "selector": "nav.bottom-nav a[href=\"/stats\"]", "capture": true },
        { "action": "wait", "ms": 1200 },
        { "action": "screenshot", "name": "stats-after-click", "html": true }
      ]
    },
    {
      "name": "mobile drawer closes on nav",
      "steps": [
        { "action": "goto", "url": "/" },
        { "action": "wait", "ms": 800 },
        { "action": "click", "selector": "label.sidebar-toggle-btn", "capture": true },
        { "action": "click", "selector": "aside.sidebar a[href=\"/analytics\"]", "capture": true },
        { "action": "wait", "ms": 1200 },
        { "action": "screenshot", "name": "after-nav-from-drawer", "html": true }
      ]
    },
    {
      "name": "subnav buttons survive the swap",
      "steps": [
        { "action": "goto", "url": "/" },
        { "action": "wait", "ms": 1000 },
        { "action": "click", "selector": "nav.subnav a[href=\"/stats\"]" },
        { "action": "wait", "ms": 1200 },
        { "action": "screenshot", "name": "subnav-after-click", "html": true }
      ]
    },
    {
      "name": "section layout",
      "steps": [
        { "action": "goto", "url": "/section" },
        { "action": "wait", "ms": 1200 },
        { "action": "screenshot", "name": "section", "html": true }
      ]
    }
  ]
}
